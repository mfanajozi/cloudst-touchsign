# Populated by neon deploy. Never commit credentials.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_COOKIE_SECRET=
# Optional aliases: the AWS_* storage variables from neon deploy are also supported.
# Leave aliases blank to use their AWS_* equivalents.
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=
NEON_STORAGE_BUCKET=assets
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# AWS-standard storage settings (used when corresponding aliases are blank).
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Enable only behind a proxy that overwrites incoming forwarding headers.
TRUST_PROXY_HEADERS=
